# Ecstasy Universal LLM Configuration (Optional)
# Ecstasy runs 100% deterministically offline via Clang + Z3 SMT when no LLM key is set.
# To enable optional LLM-guided IR synthesis, configure any OpenAI-compatible endpoint:

# API Key (OpenAI, OpenRouter, Anthropic-compatible proxy, or leave blank for local Ollama)
LLM_API_KEY=

# Base URL (Examples: https://api.openai.com/v1, https://openrouter.ai/api/v1, http://localhost:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1

# Model Identifier (Examples: gpt-4o-mini, claude-3-5-sonnet, llama3.3:70b, qwen2.5-coder:32b)
LLM_MODEL=gpt-4o-mini

# Generation Parameters
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=45